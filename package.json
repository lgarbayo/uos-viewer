{
  "name": "uos-viewer",
  "version": "0.1.0",
  "description": "Visor de referencia del formato Unified Oral Scene (.uos): abre un contenedor dental por rangos HTTP sin saber quien lo escribio. Layer 1, sin inferencia.",
  "keywords": [
    "uos",
    "unified-oral-scene",
    "dental",
    "dental-imaging",
    "cbct",
    "dicom",
    "intraoral-scanner",
    "gaussian-splatting",
    "digital-twin",
    "threejs",
    "webgl",
    "medical-imaging",
    "zip-range-requests",
    "typescript",
    "file-format"
  ],
  "license": "MIT",
  "author": "ANFAIA / Agentic Smart Health",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
